# Production stack environment — copy to .env and fill in, or run
# scripts/deploy-prod.sh which prompts for the URLs and generates the secrets.
# .env is gitignored; never commit real values.

# Postgres (prod db service)
POSTGRES_DB=warehouse_backend
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me

# JWT signing secret for the backend (required)
AUTH_SECRET=change-me

# Scheme + host of the deployment, no port (e.g. https://mobile-wms-admin.wclsolution.com
# or http://192.168.1.10). Drives the web/admin API URL default (${PRODUCTION_URL}:9002)
# and the APK's WebView URL (${PRODUCTION_URL}:3000).
PRODUCTION_URL=

# Optional: delegate login to the DocPal API (e.g. https://uat.docpal.weltronics.com).
# Leave empty for local scrypt auth.
DOCPAL_URL=

# Optional: password for the warehouse_sync DB role (external sync service).
# Defaults to "warehouse_sync" when unset.
# SYNC_DB_PASSWORD=

# Optional: label-printing-center print service base URL (backend proxies
# /print/* to it). Defaults to http://192.168.5.116:9003.
# PRINT_API_BASE_URL=http://192.168.5.116:9003

# Optional: flow config JSON override of the warehouse_config row "flow".
# FLOW_CONFIG=
