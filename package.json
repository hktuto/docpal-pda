{
  "name": "warehouse-pda",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @warehouse/web dev",
    "dev:backend": "pnpm --filter @warehouse/backend dev",
    "dev:admin": "pnpm --filter @warehouse/admin dev",
    "dev:proxy": "pnpm --filter @warehouse/web cap:android:proxy",
    "build": "pnpm -r build",
    "generate": "pnpm --filter @warehouse/web generate",
    "test": "pnpm -r test",
    "cap:sync": "pnpm --filter @warehouse/web cap:sync",
    "cap:android": "pnpm --filter @warehouse/web cap:android",
    "cap:android:dev": "pnpm --filter @warehouse/web cap:android:dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
