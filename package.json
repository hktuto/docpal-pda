{
  "name": "web-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "cap:android": "nuxt generate && cap sync android && cap open android",
    "cap:android:dev": "node scripts/cap-android-dev.mjs",
    "generate:ocr-labels-pdf": "node scripts/generate-ocr-labels-pdf.mjs",
    "generate:box-shelf-labels-pdf": "node scripts/generate-box-shelf-labels-pdf.mjs",
    "generate:precalc-seed": "vitest run --config vitest.generator.config.ts scripts/generate-precalc-seed.test.ts",
    "generate:ocr-labels": "vitest run --config vitest.generator.config.ts scripts/generate-ocr-labels.test.ts",
    "generate:labels-data": "vitest run --config vitest.generator.config.ts scripts/generate-labels-data.test.ts",
    "assets:generate": "npx capacitor-assets generate --android --assetPath resources",
    "assets:android": "pnpm assets:generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@electric-sql/pglite": "^0.3.0",
    "drizzle-orm": "^0.45.0",
    "jsbarcode": "^3.12.3",
    "nuxt": "^3.12.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@nuxtjs/i18n": "^10.4.0",
    "@types/node": "^26.1.0",
    "@types/uuid": "^9.0.8",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.7"
  }
}
