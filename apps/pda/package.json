{
  "name": "@warehouse/pda",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0 --port 3104",
    "generate": "nuxt generate",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "cap:android": "nuxt generate && node scripts/cap-android-bundled.mjs",
    "cap:android:proxy": "node scripts/cap-android-proxy.mjs",
    "cap:android:dev": "node scripts/cap-android-proxy.mjs && cap sync android && cap open android",
    "assets:generate": "npx capacitor-assets generate --android --assetPath resources",
    "assets:android": "pnpm assets:generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "nuxt": "^3.12.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^26.1.0",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.7"
  }
}
