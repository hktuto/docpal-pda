{
  "name": "@warehouse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "gen:seed": "pnpm --filter @warehouse/web exec vitest run --config vitest.generator.config.ts scripts/export-api-seed.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@warehouse/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.29"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
