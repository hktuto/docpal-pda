{
  "name": "@warehouse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test --test-force-exit --test-concurrency=1 src/**/*.test.ts",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "tsx node_modules/drizzle-kit/bin.cjs studio",
    "gen:seed": "pnpm --filter @warehouse/web exec vitest run --config vitest.generator.config.ts scripts/export-api-seed.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@warehouse/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.29",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
