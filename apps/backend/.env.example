DATABASE_URL=postgresql://warehouse:warehouse@localhost:5432/warehouse_backend
PORT=3002
# WAREHOUSE_CODE=HK1
# CORS_ORIGINS=http://localhost:3000,http://localhost,capacitor://localhost

# Serverless (Vercel + Neon) — set on the Vercel project, not here:
# PG_MAX=1            # one connection per function instance
# PG_PREPARE=false    # Neon pooler (PgBouncer transaction mode) rejects prepared statements
# WAREHOUSE_SEED=off  # no boot-time seed on Vercel (seed once via pnpm db:seed)
# DEV_ROUTES=off      # kill switch for /dev/* demo routes (default on)
