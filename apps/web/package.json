{
  "name": "@warehouse/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "cap:android": "nuxt generate && cap sync android && cap open android",
    "cap:android:dev": "node scripts/cap-android-dev.mjs",
    "generate:ocr-labels-pdf": "node scripts/generate-ocr-labels-pdf.mjs",
    "generate:box-shelf-labels-pdf": "node scripts/generate-box-shelf-labels-pdf.mjs",
    "assets:generate": "npx capacitor-assets generate --android --assetPath resources",
    "assets:android": "pnpm assets:generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "bwip-js": "^4.11.2",
    "jsbarcode": "^3.12.3",
    "nuxt": "^3.12.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@nuxtjs/i18n": "^10.4.0",
    "@types/node": "^26.1.0",
    "@types/uuid": "^9.0.8",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.7"
  }
}
